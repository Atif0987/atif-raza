{{ 'custom-header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-header.js' | asset_url }}" defer></script>

<header
  class="custom-header"
  style="
    --header-bg: {{ section.settings.background }};
    --header-text: {{ section.settings.text_color }};
    --header-button-bg: {{ section.settings.button_background }};
    --header-button-text: {{ section.settings.button_text_color }};
  "
>

  <!-- Desktop Header -->

  <div class="custom-header__desktop">

    <div class="page-width">

      <div class="custom-header__desktop-inner">

        <a
          href="{{ routes.root_url }}"
          class="custom-header__logo"
        >

          {% if section.settings.logo %}
            {{
              section.settings.logo
              | image_url: width: 220
              | image_tag:
              class: 'custom-header__logo-image',
              loading: 'eager',
              alt: shop.name
            }}
          {% else %}
            {{ shop.name }}
          {% endif %}

        </a>

        <div class="custom-header__announcement">
          {{ section.settings.announcement }}
        </div>

        <a
          href="{{ section.settings.button_link }}"
          class="custom-header__button"
        >
          {{ section.settings.button_text }}
          <span class="custom-header__arrow"><svg width="68" height="30" viewBox="0 0 68 30" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M2 12.7279L1.96701e-07 12.7279L-1.96701e-07 16.7279L2 16.7279L2 12.7279ZM67.4142 16.1421C68.1953 15.3611 68.1953 14.0947 67.4142 13.3137L54.6863 0.585774C53.9052 -0.195275 52.6389 -0.195275 51.8579 0.585774C51.0768 1.36682 51.0768 2.63315 51.8579 3.4142L63.1716 14.7279L51.8579 26.0416C51.0768 26.8227 51.0768 28.089 51.8579 28.87C52.6389 29.6511 53.9052 29.6511 54.6863 28.87L67.4142 16.1421ZM2 16.7279L66 16.7279L66 12.7279L2 12.7279L2 16.7279Z" fill="black"/>
            </svg>
            </span>
        </a>

      </div>

    </div>

  </div>

  <!-- Mobile Header -->

  <div class="custom-header__mobile">

    <div class="custom-header__mobile-top">

      <button
        class="custom-header__toggle"
        type="button"
        aria-label="Open Menu"
        aria-expanded="false"
      >
        ☰
      </button>

      <a
        href="{{ routes.root_url }}"
        class="custom-header__logo"
      >

        {% if section.settings.logo %}
          {{
            section.settings.logo
            | image_url: width: 180
            | image_tag:
            class: 'custom-header__logo-image',
            loading: 'eager',
            alt: shop.name
          }}
        {% else %}
          {{ shop.name }}
        {% endif %}

      </a>

    </div>

    <div class="custom-header__drawer">

      <div class="custom-header__drawer-header">

        <button
          class="custom-header__close"
          type="button"
          aria-label="Close Menu"
        >
          ✕
        </button>

        <a
          href="{{ routes.root_url }}"
          class="custom-header__logo"
        >

          {% if section.settings.logo %}
            {{
              section.settings.logo
              | image_url: width: 180
              | image_tag:
              class: 'custom-header__logo-image',
              loading: 'lazy',
              alt: shop.name
            }}
          {% else %}
            {{ shop.name }}
          {% endif %}

        </a>

      </div>

      <div class="custom-header__drawer-content">

        <div class="custom-header__announcement">
          {{ section.settings.announcement }}
        </div>

        <a
          href="{{ section.settings.button_link }}"
          class="custom-header__button"
        >
          {{ section.settings.button_text }}
          <span class="custom-header__arrow">→</span>
        </a>

      </div>

    </div>

  </div>

</header>

{% schema %}
{
  "name": "Custom Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "announcement",
      "label": "Announcement",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#F5F3EE"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button Background",
      "default": "#F8E81C"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#111111"
    }
  ],
  "presets": [
    {
      "name": "Custom Header"
    }
  ]
}
{% endschema %}