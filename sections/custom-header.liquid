{{ 'custom-header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-header.js' | asset_url }}" defer></script>

<header
  class="custom-header"
  style="
    --header-bg: {{ section.settings.background }};
    --header-text: {{ section.settings.text_color }};
    --header-button-bg: {{ section.settings.button_background }};
    --header-button-text: {{ section.settings.button_text_color }};
  "
>

  <!-- Desktop Header -->

  <div class="custom-header__desktop">

    <div class="page-width">

      <div class="custom-header__desktop-inner">

        <a
          href="{{ routes.root_url }}"
          class="custom-header__logo"
        >

          {% if section.settings.logo %}
            {{
              section.settings.logo
              | image_url: width: 220
              | image_tag:
              class: 'custom-header__logo-image',
              loading: 'eager',
              alt: shop.name
            }}
          {% else %}
            {{ shop.name }}
          {% endif %}

        </a>

        <div class="custom-header__announcement">
          {{ section.settings.announcement }}
        </div>

        <a
          href="{{ section.settings.button_link }}"
          class="custom-header__button"
        >
          {{ section.settings.button_text }}
          <span class="custom-header__arrow">→</span>
        </a>

      </div>

    </div>

  </div>

  <!-- Mobile Header -->

  <div class="custom-header__mobile">

    <div class="custom-header__mobile-top">

      <button
        class="custom-header__toggle"
        type="button"
        aria-label="Open Menu"
        aria-expanded="false"
      >
        ☰
      </button>

      <a
        href="{{ routes.root_url }}"
        class="custom-header__logo"
      >

        {% if section.settings.logo %}
          {{
            section.settings.logo
            | image_url: width: 180
            | image_tag:
            class: 'custom-header__logo-image',
            loading: 'eager',
            alt: shop.name
          }}
        {% else %}
          {{ shop.name }}
        {% endif %}

      </a>

    </div>

    <div class="custom-header__drawer">

      <div class="custom-header__drawer-header">

        <button
          class="custom-header__close"
          type="button"
          aria-label="Close Menu"
        >
          ✕
        </button>

        <a
          href="{{ routes.root_url }}"
          class="custom-header__logo"
        >

          {% if section.settings.logo %}
            {{
              section.settings.logo
              | image_url: width: 180
              | image_tag:
              class: 'custom-header__logo-image',
              loading: 'lazy',
              alt: shop.name
            }}
          {% else %}
            {{ shop.name }}
          {% endif %}

        </a>

      </div>

      <div class="custom-header__drawer-content">

        <div class="custom-header__announcement">
          {{ section.settings.announcement }}
        </div>

        <a
          href="{{ section.settings.button_link }}"
          class="custom-header__button"
        >
          {{ section.settings.button_text }}
          <span class="custom-header__arrow">→</span>
        </a>

      </div>

    </div>

  </div>

</header>

{% schema %}
{
  "name": "Custom Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "announcement",
      "label": "Announcement",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#F5F3EE"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button Background",
      "default": "#F8E81C"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#111111"
    }
  ],
  "presets": [
    {
      "name": "Custom Header"
    }
  ]
}
{% endschema %}