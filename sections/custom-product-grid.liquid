{{ 'custom-product-grid.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-product-grid.js' | asset_url }}" defer></script>

<div
  class="custom-product-grid"
  style="
    --section-bg: {{ section.settings.background_color }};
    --heading-color: {{ section.settings.heading_color }};
  "
>
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <h2 class="custom-product-grid__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="custom-product-grid__grid">

      {% for block in section.blocks %}

        {% assign product = block.settings.product %}

        <div
          class="custom-product-grid__item"
          {{ block.shopify_attributes }}
        >

          {% if block.settings.custom_image != blank %}

            {{
              block.settings.custom_image
              | image_url: width: 900
              | image_tag:
                class: 'custom-product-grid__image',
                loading: 'lazy',
                alt: product.title
            }}

          {% elsif product.featured_image %}

            {{
              product.featured_image
              | image_url: width: 900
              | image_tag:
                class: 'custom-product-grid__image',
                loading: 'lazy',
                alt: product.title
            }}

          {% endif %}

          <button
            type="button"
            class="custom-product-grid__hotspot"
            style="
              left: {{ block.settings.hotspot_x }}%;
              top: {{ block.settings.hotspot_y }}%;
            "
            data-product-id="{{ product.id }}"
            data-product-handle="{{ product.handle }}"
          >
            +
          </button>

        </div>

      {% endfor %}

    </div>

    <!-- Popup will come here later -->

  </div>
</div>

{% schema %}
{
  "name": "Custom Product Grid",
  "tag": "section",
  "class": "section-custom-product-grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vision in the wild"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#111111"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Grid Image (Optional)"
        },
        {
          "type": "range",
          "id": "hotspot_x",
          "label": "Hotspot Horizontal Position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "hotspot_y",
          "label": "Hotspot Vertical Position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Custom Product Grid"
    }
  ]
}
{% endschema %}