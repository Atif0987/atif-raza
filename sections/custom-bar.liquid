{{ 'custom-bar.css' | asset_url | stylesheet_tag }}

<div
  class="custom-bar"
  style="
    --custom-bar-bg: {{ section.settings.background_color }};
    --custom-bar-text: {{ section.settings.text_color }};
  "
>
  <div class="page-width">

    {% if section.settings.text != blank %}
      <div class="custom-desktop-bar__text">
        {{ section.settings.text }}
      </div>
    {% endif %}

    {% if section.settings.mobile_text != blank %}
        <div class="custom-mobile-bar__text">
            {{ section.settings.mobile_text }}
        </div>
    {% endif %}

  </div>
</div>

{% schema %}
{
  "name": "Custom Bar",
  "tag": "section",
  "class": "section-custom-bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Desktop Text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    },
    {
        "type": "text",
        "id": "mobile_text",
        "label": "Mobile Text",
        "default":"SUSTAINABLE, ETHICALLY MADE ACTIVEWEAR"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#F5F5F5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
  ],
  "presets": [
    {
      "name": "Custom Bar"
    }
  ]
}
{% endschema %}