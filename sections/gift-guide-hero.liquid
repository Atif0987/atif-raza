{{ 'gift-guide.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gift-guide.js' | asset_url }}" defer></script>

<div
  class="gift-guide"
  style="
    --gift-guide-bg: {{ section.settings.section_background }};
    --gift-guide-heading: {{ section.settings.heading_color }};
    --gift-guide-description: {{ section.settings.description_color }};
  "
>
  <div class="page-width">

    <div class="gift-guide__hero">

      {% if section.settings.hero_image != blank %}
        {{
          section.settings.hero_image
          | image_url: width: 2200
          | image_tag:
            class: 'gift-guide__image',
            loading: 'eager',
            fetchpriority: 'high',
            alt: section.settings.hero_image.alt
        }}
      {% endif %}

      <div class="gift-guide__content">

        {% if section.settings.heading != blank %}
          <h1 class="gift-guide__heading">
            {{ section.settings.heading }}
          </h1>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="gift-guide__description">
            {{ section.settings.description }}
          </div>
        {% endif %}

        {% if section.settings.button_text != blank %}
          <a
            href="{{ section.settings.button_link }}"
            class="gift-guide__button"
          >
            <span class="gift-guide__button-text">
              {{ section.settings.button_text }}
            </span>

            <span class="gift-guide__button-icon" aria-hidden="true">
              <svg width="68" height="30" viewBox="0 0 68 30" xmlns="http://www.w3.org/2000/svg">
                <path
                  d="M2 12.7279L1.96701e-07 12.7279L-1.96701e-07 16.7279L2 16.7279L2 12.7279ZM67.4142 16.1421C68.1953 15.3611 68.1953 14.0947 67.4142 13.3137L54.6863 0.585774C53.9052 -0.195275 52.6389 -0.195275 51.8579 0.585774C51.0768 1.36682 51.0768 2.63315 51.8579 3.4142L63.1716 14.7279L51.8579 26.0416C51.0768 26.8227 51.0768 28.089 51.8579 28.87C52.6389 29.6511 53.9052 29.6511 54.6863 28.87L67.4142 16.1421ZM2 16.7279L66 16.7279L66 12.7279L2 12.7279L2 16.7279Z"
                  fill="currentColor"
                />
              </svg>
            </span>
          </a>
        {% endif %}

      </div>

    </div>

  </div>
</div>

{% schema %}
{
  "name": "Gift Guide Hero",
  "tag": "section",
  "class": "section-gift-guide-hero",
  "settings": [
    {
      "type": "header",
      "content": "Hero Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Hero Images"
    },
        {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description color",
      "default": "#555555"
    }
  ],
  "presets": [
    {
      "name": "Gift Guide Hero"
    }
  ]
}
{% endschema %}